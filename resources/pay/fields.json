{
    "_": "The form of each payment format: which fields, in which order, and how to show them. The format list and the payload code come from hop-pay (resources/js/vendor/hop-pay.js); this file only describes the form. scripts/vendor-hop-pay.mjs refuses to continue when the module has a format that is missing here. payee = the field shown as the payee name; note = the field that carries the block's short note, or null when the format has none; mono = show the value in a monospace face.",
    "paypal": {
        "name": "PayPal.me",
        "payee": "user",
        "note": null,
        "fields": [
            { "key": "user", "label": "PayPal.me name", "hint": "Letters and digits only, as in paypal.me/yourname.", "max": 60 },
            { "key": "currency", "label": "Currency", "kind": "currency", "default": "USD", "max": 3 }
        ]
    },
    "cashapp": {
        "name": "Cash App",
        "payee": "cashtag",
        "note": null,
        "fields": [
            { "key": "cashtag", "label": "Cashtag", "hint": "With or without the $.", "max": 30 }
        ]
    },
    "venmo": {
        "name": "Venmo",
        "payee": "user",
        "note": "note",
        "fields": [
            { "key": "user", "label": "Venmo username", "max": 40 }
        ]
    },
    "solana": {
        "name": "Solana Pay",
        "payee": "label",
        "note": "message",
        "fields": [
            { "key": "recipient", "label": "Wallet address", "hint": "A Solana address (32 bytes, base58).", "max": 60, "mono": true },
            { "key": "label", "label": "Payee name", "hint": "Shown by the wallet.", "max": 80 },
            { "key": "splToken", "label": "Token address (optional)", "hint": "Leave empty to be paid in SOL.", "max": 60, "mono": true, "optional": true }
        ]
    },
    "upi": {
        "name": "UPI",
        "payee": "name",
        "note": "note",
        "fields": [
            { "key": "name", "label": "Payee name", "max": 99 },
            { "key": "vpa", "label": "UPI ID", "hint": "Like name@bank.", "max": 60 }
        ]
    },
    "epc": {
        "name": "EPC SEPA",
        "payee": "name",
        "note": "reference",
        "fields": [
            { "key": "name", "label": "Account holder", "max": 70 },
            { "key": "iban", "label": "IBAN", "max": 42, "mono": true },
            { "key": "bic", "label": "BIC (optional)", "max": 11, "mono": true, "optional": true }
        ]
    },
    "promptpay": {
        "name": "PromptPay",
        "payee": "name",
        "note": null,
        "fields": [
            { "key": "name", "label": "Payee name", "max": 99 },
            { "key": "phone", "label": "Thai mobile number", "hint": "10 digits, starting 06, 08 or 09.", "kind": "tel", "max": 20 }
        ]
    },
    "vietqr": {
        "name": "VietQR",
        "payee": "name",
        "note": null,
        "fields": [
            { "key": "name", "label": "Account holder", "max": 99 },
            { "key": "bin", "label": "Bank code (BIN)", "hint": "Six digits, as published by the bank.", "max": 8, "mono": true },
            { "key": "account", "label": "Account number", "max": 30, "mono": true }
        ]
    }
}
