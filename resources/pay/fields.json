{
    "_": "The form of each payment format: which fields, in which order, and how to show them. The format list and the payload code come from hop-pay (resources/js/vendor/hop-pay.js); this file only describes the form. scripts/vendor-hop-pay.mjs refuses to continue when the module has a format that is missing here. payee = the field shown as the payee name; note = the field that carries the block's short note, or null when the format has none; mono = show the value in a monospace face. check = the cheap shape check the server runs on a stored value (the module itself runs in the browser): strip = [{re, flags}] removed first, space = remove all spaces, upper = upper-case, pattern/flags = must match, kind = iban | base58-32 | th-mobile.",
    "paypal": {
        "name": "PayPal.me",
        "payee": "user",
        "note": null,
        "fields": [
            {
                "key": "user",
                "label": "PayPal.me name",
                "hint": "Letters and digits only, as in paypal.me/yourname.",
                "max": 60,
                "check": {
                    "strip": [
                        {
                            "re": "^.*paypal\\.me/",
                            "flags": "i"
                        },
                        {
                            "re": "^@"
                        }
                    ],
                    "pattern": "^[A-Za-z0-9]{1,20}$"
                }
            },
            {
                "key": "currency",
                "label": "Currency",
                "kind": "currency",
                "default": "USD",
                "max": 3
            }
        ]
    },
    "cashapp": {
        "name": "Cash App",
        "payee": "cashtag",
        "note": null,
        "fields": [
            {
                "key": "cashtag",
                "label": "Cashtag",
                "hint": "With or without the $.",
                "max": 30,
                "check": {
                    "strip": [
                        {
                            "re": "^.*cash\\.app/",
                            "flags": "i"
                        },
                        {
                            "re": "^\\$"
                        }
                    ],
                    "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9_]{1,20}$"
                }
            }
        ]
    },
    "venmo": {
        "name": "Venmo",
        "payee": "user",
        "note": "note",
        "fields": [
            {
                "key": "user",
                "label": "Venmo username",
                "max": 40,
                "check": {
                    "strip": [
                        {
                            "re": "^@"
                        }
                    ],
                    "pattern": "^[A-Za-z0-9_-]{5,30}$"
                }
            }
        ]
    },
    "solana": {
        "name": "Solana Pay",
        "payee": "label",
        "note": "message",
        "fields": [
            {
                "key": "recipient",
                "label": "Wallet address",
                "hint": "A Solana address (32 bytes, base58).",
                "max": 60,
                "mono": true,
                "check": {
                    "kind": "base58-32"
                }
            },
            {
                "key": "label",
                "label": "Payee name",
                "hint": "Shown by the wallet.",
                "max": 80
            },
            {
                "key": "splToken",
                "label": "Token address (optional)",
                "hint": "Leave empty to be paid in SOL.",
                "max": 60,
                "mono": true,
                "optional": true,
                "check": {
                    "kind": "base58-32"
                }
            }
        ]
    },
    "upi": {
        "name": "UPI",
        "payee": "name",
        "note": "note",
        "fields": [
            {
                "key": "name",
                "label": "Payee name",
                "max": 99
            },
            {
                "key": "vpa",
                "label": "UPI ID",
                "hint": "Like name@bank.",
                "max": 60,
                "check": {
                    "pattern": "^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$"
                }
            }
        ]
    },
    "epc": {
        "name": "EPC SEPA",
        "payee": "name",
        "note": "reference",
        "fields": [
            {
                "key": "name",
                "label": "Account holder",
                "max": 70
            },
            {
                "key": "iban",
                "label": "IBAN",
                "max": 42,
                "mono": true,
                "check": {
                    "kind": "iban"
                }
            },
            {
                "key": "bic",
                "label": "BIC (optional)",
                "max": 11,
                "mono": true,
                "optional": true,
                "check": {
                    "space": true,
                    "upper": true,
                    "pattern": "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$"
                }
            }
        ]
    },
    "promptpay": {
        "name": "PromptPay",
        "payee": "name",
        "note": null,
        "fields": [
            {
                "key": "name",
                "label": "Payee name",
                "max": 99
            },
            {
                "key": "phone",
                "label": "Thai mobile number",
                "hint": "10 digits, starting 06, 08 or 09.",
                "kind": "tel",
                "max": 20,
                "check": {
                    "kind": "th-mobile"
                }
            }
        ]
    },
    "vietqr": {
        "name": "VietQR",
        "payee": "name",
        "note": null,
        "fields": [
            {
                "key": "name",
                "label": "Account holder",
                "max": 99
            },
            {
                "key": "bin",
                "label": "Bank code (BIN)",
                "hint": "Six digits, as published by the bank.",
                "max": 8,
                "mono": true,
                "check": {
                    "pattern": "^\\d{6}$"
                }
            },
            {
                "key": "account",
                "label": "Account number",
                "max": 30,
                "mono": true,
                "check": {
                    "strip": [
                        {
                            "re": "[\\s-]"
                        }
                    ],
                    "pattern": "^\\d{1,19}$"
                }
            }
        ]
    }
}
