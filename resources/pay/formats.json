{
    "paypal": {
        "name": "PayPal.me",
        "group": 1,
        "confidence": "high",
        "country": "",
        "currencies": [
            "AUD",
            "BRL",
            "CAD",
            "CHF",
            "CNY",
            "CZK",
            "DKK",
            "EUR",
            "GBP",
            "HKD",
            "HUF",
            "ILS",
            "JPY",
            "MXN",
            "MYR",
            "NOK",
            "NZD",
            "PHP",
            "PLN",
            "SEK",
            "SGD",
            "THB",
            "TWD",
            "USD"
        ],
        "payee": "user",
        "note": null,
        "fields": [
            {
                "key": "user",
                "label": "PayPal.me name",
                "hint": "Letters and digits only, as in paypal.me/yourname.",
                "max": 60,
                "check": {
                    "strip": [
                        {
                            "re": "^.*paypal\\.me/",
                            "flags": "i"
                        },
                        {
                            "re": "^@"
                        }
                    ],
                    "pattern": "^[A-Za-z0-9]{1,20}$"
                }
            },
            {
                "key": "currency",
                "label": "Currency",
                "kind": "currency",
                "default": "USD",
                "max": 3
            }
        ]
    },
    "cashapp": {
        "name": "Cash App",
        "group": 1,
        "confidence": "medium",
        "country": "US",
        "currencies": [
            "USD"
        ],
        "payee": "cashtag",
        "note": null,
        "fields": [
            {
                "key": "cashtag",
                "label": "Cashtag",
                "hint": "With or without the $.",
                "max": 30,
                "check": {
                    "strip": [
                        {
                            "re": "^.*cash\\.app/",
                            "flags": "i"
                        },
                        {
                            "re": "^\\$"
                        }
                    ],
                    "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9_]{1,20}$"
                }
            }
        ]
    },
    "venmo": {
        "name": "Venmo",
        "group": 1,
        "confidence": "medium-low",
        "country": "US",
        "currencies": [
            "USD"
        ],
        "payee": "user",
        "note": "note",
        "fields": [
            {
                "key": "user",
                "label": "Venmo username",
                "max": 40,
                "check": {
                    "strip": [
                        {
                            "re": "^@"
                        }
                    ],
                    "pattern": "^[A-Za-z0-9_-]{5,30}$"
                }
            }
        ]
    },
    "solana": {
        "name": "Solana Pay",
        "group": 1,
        "confidence": "medium",
        "country": "",
        "currencies": [
            "SOL"
        ],
        "payee": "label",
        "note": "message",
        "fields": [
            {
                "key": "recipient",
                "label": "Wallet address",
                "hint": "A Solana address (32 bytes, base58).",
                "max": 60,
                "mono": true,
                "check": {
                    "kind": "base58-32"
                }
            },
            {
                "key": "label",
                "label": "Payee name",
                "hint": "Shown by the wallet.",
                "max": 80
            },
            {
                "key": "splToken",
                "label": "Token address (optional)",
                "hint": "Leave empty to be paid in SOL.",
                "max": 60,
                "mono": true,
                "optional": true,
                "check": {
                    "kind": "base58-32"
                }
            }
        ]
    },
    "upi": {
        "name": "UPI",
        "group": 1,
        "confidence": "medium",
        "country": "IN",
        "currencies": [
            "INR"
        ],
        "payee": "name",
        "note": "note",
        "fields": [
            {
                "key": "name",
                "label": "Payee name",
                "max": 99
            },
            {
                "key": "vpa",
                "label": "UPI ID",
                "hint": "Like name@bank.",
                "max": 60,
                "check": {
                    "pattern": "^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$"
                }
            }
        ]
    },
    "epc": {
        "name": "EPC SEPA",
        "group": 2,
        "confidence": "medium",
        "country": "EU",
        "currencies": [
            "EUR"
        ],
        "payee": "name",
        "note": "reference",
        "fields": [
            {
                "key": "name",
                "label": "Account holder",
                "max": 70
            },
            {
                "key": "iban",
                "label": "IBAN",
                "max": 42,
                "mono": true,
                "check": {
                    "kind": "iban"
                }
            },
            {
                "key": "bic",
                "label": "BIC (optional)",
                "max": 11,
                "mono": true,
                "optional": true,
                "check": {
                    "space": true,
                    "upper": true,
                    "pattern": "^[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$"
                }
            }
        ]
    },
    "promptpay": {
        "name": "PromptPay",
        "group": 2,
        "confidence": "medium-low",
        "country": "TH",
        "currencies": [
            "THB"
        ],
        "payee": "name",
        "note": null,
        "fields": [
            {
                "key": "name",
                "label": "Payee name",
                "max": 99
            },
            {
                "key": "phone",
