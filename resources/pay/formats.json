    "vietqr": {
        "name": "VietQR",
        "group": 2,
        "confidence": "medium-low",
        "country": "VN",
        "currencies": [
            "VND"
        ],
        "payee": "name",
        "note": null,
        "fields": [
            {
                "key": "name",
                "label": "Account holder",
                "max": 99
            },
            {
                "key": "bin",
                "label": "Bank code (BIN)",
                "hint": "Six digits, as published by the bank.",
                "max": 8,
                "mono": true,
                "check": {
                    "pattern": "^\\d{6}$"
                }
            },
            {
                "key": "account",
                "label": "Account number",
                "max": 30,
                "mono": true,
                "check": {
                    "strip": [
                        {
                            "re": "[\\s-]"
