APP_NAME=BioHop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The dashboard (editor, admin). Production: https://bio.hel.ink
APP_URL=http://localhost
# Where the public bio pages are reached: hel.ink/b/{slug}, /b/{slug}/qr, /b/click/{id}.
# nginx at hel.ink sends /b/* here. Defaults to APP_URL (local dev without the router).
PUBLIC_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# "cloudflare", "*", or a comma-separated list of proxy IPs.
TRUSTED_PROXIES=

# The HOP owner's email (admin everywhere, content never auto-actioned by abuse:scan).
SUPERADMIN_EMAIL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The shared HOP database (same values as the hub and LinkHop). BioHop logs its migrations in migrations_bio.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helink_db
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATIONS_TABLE=migrations_bio

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=biohop_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# HOP ID (hop/auth): this app's slug at the hub, the hub's address, and the SSO secret
# (HOP_SSO_SECRET or HOP_SSO_SECRET_BIOHOP; 32+ characters).
HOP_APP=biohop
HOP_HUB_URL=https://hub.hel.ink
HOP_SSO_SECRET=
# Previous secret during zero-downtime rotation (optional):
# HOP_SSO_SECRET_PREV=

# The other apps (hop/ui navigation; LinkHop is also the shortener behind "shorten this URL").
LINKHOP_URL=https://link.hel.ink
LINKHOP_ENABLED=true
BIOHOP_URL=https://bio.hel.ink
PIXELHOP_URL=https://p.hel.ink
PIXELHOP_ENABLED=true
# Seconds to wait for LinkHop's API.
BIO_LINKHOP_TIMEOUT=8

# Bio pages: minimum slug length for members (admins: 3) and pages per account.
BIO_SLUG_MIN_LENGTH=5
BIO_MAX_PAGES=3

# hop/safety: optional reputation lookups for abuse:scan and the editor's URL checks.
SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
SPAMHAUS_DBL=true

# GeoIP for click analytics (country only). The local MaxMind database is tried first
# (storage/app/GeoLite2-City.mmdb), then the free web APIs; keys are optional.
GEOLITE_ACCOUNT_ID=
GEOLITE_LICENSE_KEY=
IPINFO_API_KEY=
ABSTRACTAPI_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hel.ink"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
