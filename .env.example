APP_NAME=BioHop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The dashboard (editor, admin). Production: https://bio.hel.ink
APP_URL=http://localhost
# Where the public bio pages are reached: hel.ink/b/{slug}, /b/{slug}/qr, /b/click/{id}.
# nginx at hel.ink sends /b/* here. Defaults to APP_URL (local dev without the router).
PUBLIC_URL=http://localhost
# Where uploads (/storage) and built files (/build, /images, /fonts) are served. Empty: APP_URL. Public bio pages
# (hel.ink/b/...) point their pictures, icons and fonts here, so this host must serve those paths (with
# Access-Control-Allow-Origin for the public host on /fonts, /build and /storage).
ASSET_URL=
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# "cloudflare", "*", or a comma-separated list of proxy IPs.
TRUSTED_PROXIES=
# Public bio pages may be kept at Cloudflare's edge for a minute (README, "Behind Cloudflare"). With a zone id and an
# API token that may purge that zone's cache, a saved page or block is purged from the edge at once; empty: headers only.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# The HOP owner's email (admin everywhere, content never auto-actioned by abuse:scan).
SUPERADMIN_EMAIL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The shared HOP database (same values as the hub and LinkHop). BioHop logs its migrations in migrations_bio.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helink_db
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATIONS_TABLE=migrations_bio

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=biohop_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# HOP ID (hop/auth): this app's slug at the hub, the hub's address, and the SSO secret
# (HOP_SSO_SECRET or HOP_SSO_SECRET_BIOHOP; 32+ characters).
HOP_APP=biohop
HOP_HUB_URL=https://hub.hel.ink
HOP_SSO_SECRET=
# Previous secret during zero-downtime rotation (optional):
# HOP_SSO_SECRET_PREV=

# Silent account re-check (hop/auth): a session the hub has not vouched for in this many seconds is confirmed with one
# prompt=none round trip, so switching accounts at the hub does not leave the old account here. false turns it off.
# HOP_RECHECK=true
# HOP_RECHECK_MAX_AGE=300

# The admin pages moved to the HOP control center (Imperium). Setting this sends
# /admin/* there; leaving it empty shows the "panel moved" page.
#HOP_CONTROL_URL=https://citadel.hel.ink
#HOP_CONTROL_NAME="Control center"

# The other apps (hop/ui navigation; LinkHop is also the shortener behind "shorten this URL").
LINKHOP_URL=https://link.hel.ink
LINKHOP_ENABLED=true
BIOHOP_URL=https://bio.hel.ink
PIXELHOP_URL=https://p.hel.ink
PIXELHOP_ENABLED=true
# Seconds to wait for LinkHop's API.
BIO_LINKHOP_TIMEOUT=8
# "Choose from PixelHop" in the bio editor: pick a picture already in PixelHop for the image block, carousel,
# avatar, cover or favicon. The file stays in PixelHop; the page keeps its address. Turn on once PixelHop
# answers GET /api/v1/me/media for this app (PIXELHOP_MEDIA_CLIENTS=biohop there); off, the editor offers uploads only.
BIO_PIXELHOP_PICKER=false
# Where BioHop calls PixelHop (empty: PIXELHOP_URL) and which hosts a picked address may use.
BIO_PIXELHOP_URL=
BIO_PIXELHOP_HOSTS=pixel.hel.ink,p.hel.ink
BIO_PIXELHOP_TIMEOUT=6
# "Choose from NoteHop" for a link block: a public note with a read-only link (never an encrypted one). Turn on once
# NoteHop answers GET /api/v1/me/notes for this app (NOTEHOP_NOTES_CLIENTS=biohop there, the default).
BIO_NOTEHOP_PICKER=false
BIO_NOTEHOP_URL=https://note.hel.ink
BIO_NOTEHOP_TIMEOUT=6
# Signs the picker calls to PixelHop and NoteHop (32+ characters, e.g. openssl rand -base64 48). Set the same value as
# HOP_PICKER_SECRET in PixelHop and NoteHop, then those apps no longer need this app's SSO secret
# (HOP_SSO_SECRET_BIOHOP there can be removed). Empty: the picker calls are signed with HOP_SSO_SECRET as before.
HOP_PICKER_SECRET=

# Bio pages: minimum slug length for members (admins: 3) and pages per account.
BIO_SLUG_MIN_LENGTH=5
BIO_MAX_PAGES=3
# The day the retired WhatsApp rotator block stops for good (YYYY-MM-DD). Empty: the dashboard notice names no date.
BIO_WHATSAPP_RETIRE_ON=

# hop/safety: optional reputation lookups for abuse:scan and the editor's URL checks.
SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
SPAMHAUS_DBL=true

# GeoIP for click analytics (country only). A local database is tried first, then the free web APIs.
# For the local one, download GeoLite2-City.mmdb (MaxMind) or the DB-IP Lite City file yourself and
# save it as storage/app/GeoLite2-City.mmdb (an optional ASN file: storage/app/GeoLite2-ASN.mmdb).
# There is no downloader command; without the file the web APIs are used. Other paths:
# GEOLITE_CITY_DB=
# GEOLITE_ASN_DB=
# GEOIP_WEB_PROVIDERS=false stops BioHop from sending a visitor's address to any web service; then only the local
# file above answers and the country stays empty without it. Default: true.
GEOIP_WEB_PROVIDERS=true
# Optional keys for the web APIs:
IPINFO_API_KEY=
ABSTRACTAPI_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hel.ink"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
